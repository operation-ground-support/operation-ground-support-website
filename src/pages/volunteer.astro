---
import Base from '../layouts/Base.astro'
import EventList from '../components/EventList.astro'
import Photo from '../components/Photo.astro'
import Todo from '../components/Todo.astro'
import { org } from '../data/org'
import poster from '../assets/photos/matthew-25-poster.jpg'

const locale = 'en' as const
---

<Base
  title="Volunteer"
  description="Sort donations, pack bags, and staff distributions with Operation Ground Support in Old East Dallas."
  locale={locale}
  pageKey="volunteer"
  lastReviewed="2026-08-27"
>
  <h1>Volunteer</h1>

  <section class="section">
    <h2>What you would actually do</h2>
    <ul class="tasks">
      <li>No experience is needed and no commitment is required beyond the shift you sign up for</li>
      <li>Help the kitchen make soups out of surplus produce</li>
      <li>Organize food boxes</li>
      <li>Sort clothing and other things for TODO</li>
    </ul>
  </section>

  <section class="section">
    <h2>Signing up</h2>
    {
      org.signUpUrl ? (
        <p><a class="button" href={org.signUpUrl} rel="noopener">Sign up to volunteer</a></p>
      ) : (
        <Todo label="Link needed">
          Put the volunteer sign-up form URL in <code>org.signUpUrl</code>. The current site uses a
          Google Form, which is fine — link it here rather than making it a separate nav item.
        </Todo>
      )
    }
  </section>

  <EventList locale={locale} />

  <Photo
    src={poster}
    alt="A printed passage from Matthew 25 on a hallway wall, beside a stained-glass-style picture of a woman and a haloed, bearded man seated at a small table with a bowl of soup between them."
    caption="At the Grace UMC location"
  />
</Base>

<style>
  .tasks {
    margin-block-start: var(--space-s);
    padding-inline-start: var(--space-m);
  }

  .tasks li + li {
    margin-block-start: var(--space-2xs);
  }

  .note {
    margin-block-start: var(--space-m);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
