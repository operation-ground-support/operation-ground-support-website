---
import Base from '../layouts/Base.astro'
import { org } from '../data/org'
import { path } from '../i18n/routes'
---

<Base
  title="Page not found"
  description="A page at this URL does not exist."
  locale="en"
  pageKey="home"
  lastReviewed="2026-08-27"
  noindex
>
  <h1>A page at this URL does not exist</h1>
  <p class="lede">
    It may have moved. See
    {' '}<a href={path('partners', 'en')!}>Partners</a>,
    {' '}<a href={path('donate', 'en')!}>Donate</a>, and
    {' '}<a href={path('contact', 'en')!}>Contact</a>.
  </p>
  <p class="note">
    If you were looking for something specific, email <a href={`mailto:${org.email}`}>{org.email}</a>.
  </p>
</Base>

<style>
  .note {
    margin-block-start: var(--space-l);
    color: var(--ink-muted);
  }
</style>
