---
/**
 * Homepage.
 *
 * The largest thing on this page is a sentence, not a photograph. That is the central design
 * decision of the site: restraint reads as sophistication in this sector, a typographic opening
 * survives the logo not being finished, and it means the page needs one good photograph instead
 * of five.
 */
import Base from '../layouts/Base.astro'
import Doors from '../components/Doors.astro'
import NeedsList from '../components/NeedsList.astro'
import MetricRow from '../components/MetricRow.astro'
import EventList from '../components/EventList.astro'
import PhotoSlot from '../components/PhotoSlot.astro'
import { org } from '../data/org'
import { path } from '../i18n/routes'
import { getCollection } from 'astro:content'
import { formatDate } from '../i18n/ui'

const locale = 'en' as const

const updates = (await getCollection('updates', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2)

const hours = org.dropOff.hours

/* Split around the tax status so it can be held on one line. Splitting rather than hardcoding
   means this degrades to plain text if `org.mission` is ever reworded without the token. */
const STATUS = '501(c)(3)'
const missionParts = org.mission.split(STATUS)
---

<Base
  title="Home"
  description={`${org.name} is a 501(c)(3) collecting and distributing clothing, food, hygiene supplies, and household goods from the basement of Grace United Methodist Church in Old East Dallas.`}
  locale={locale}
  pageKey="home"
  lastReviewed="2026-08-27"
>
  <p class="eyebrow">Old East Dallas</p>
  <h1 class="statement">
    {
      missionParts.map((part, i) => (
        <Fragment>
          {i > 0 && <span class="nowrap">{STATUS}</span>}
          {part}
        </Fragment>
      ))
    }
  </h1>

  {
    org.lede ? (
      <p class="lede">{org.lede}</p>
    ) : (
      /* NOTE: The only thing I wanted to add to this lede is to add on "with dignity". The specific context given to me by Anne Winters is that it is very common for homeless or food-insecure people to be embarrased, and we want to treat them with some dignity. But in a short lede at the beginning of the website, it can be interpreted differently, and also it is ambiguous how this already long sentence flows */
      <p class="lede">
       We support partners with community hubs across Dallas to deliver zero-barrier direct relief, lead collaborative homelessness summits, and build holistic stabilization, for our unhoused and food-insecure neighbors.
      </p>
    )
  }

  <Doors locale={locale} />

  <MetricRow locale={locale} />

  <div class="band full">
    <div class="layout">
      <NeedsList locale={locale} />
    </div>
  </div>

  <PhotoSlot
    width="wide"
    brief="The one photograph on this page. Shoot the shelves — stocked or bare, both are honest — or boxes staged for a distribution. No faces. Natural light, shot straight-on rather than at an angle."
  />

  <EventList locale={locale} />

  {
    updates.length > 0 && (
      <section class="recent">
        <h2>Recent updates</h2>
        <ul>
          {updates.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {formatDate(post.data.date, locale)}
              </time>
              <a href={`/updates/${post.id}`}>{post.data.title}</a>
              <p>{post.data.summary}</p>
            </li>
          ))}
        </ul>
        <p><a href={path('updates', locale)!}>All updates</a></p>
      </section>
    )
  }

  <section class="find">
    <h2>Where to find us</h2>
    <p>
      TODO not sure if we just point at the events, and rely on the information in the part of "Upcoming" projected above
    </p>
    {
      hours.length > 0 && (
        <dl class="hours">
          {hours.map((h) => (
            <div>
              <dt>{h.days.en}</dt>
              <dd>{h.time.en}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <p><a href={path('contact', locale)!}>Directions and drop-off instructions</a></p>
  </section>
</Base>

<style>
  /* The opening statement. Serif, large, tight — and capped in width so it stays a sentence
     someone reads rather than a banner they skim past. Four lines is the target: past that it
     stops reading as a sentence and starts reading as a wall. If `--measure` moves, re-check
     the line count here, because `ch` is relative to the font size and not to the column. */
  .statement {
    font-size: var(--text-3xl);
    line-height: 1.14;
    letter-spacing: -0.015em;
    margin-block-start: var(--space-2xs);
    max-width: 28ch;
    text-wrap: balance;
  }

  /* Parentheses are line-break opportunities, so `501(c)(3)` will happily split across two
     lines at display sizes. This keeps it whole without putting invisible characters into a
     string that people copy and paste. */
  .nowrap {
    white-space: nowrap;
  }

  .lede {
    margin-block-start: var(--space-m);
  }

  .recent,
  .find {
    margin-block-start: var(--space-2xl);
  }

  .recent ul {
    list-style: none;
    padding: 0;
    margin-block: var(--space-m);
  }

  .recent li {
    padding-block: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }

  .recent time {
    display: block;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .recent a {
    font-weight: 500;
  }

  .recent p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-3xs);
  }

  .hours {
    margin-block: var(--space-s);
    display: grid;
    gap: var(--space-3xs) var(--space-m);
    grid-template-columns: max-content 1fr;
    font-variant-numeric: tabular-nums;
  }

  .hours > div {
    display: contents;
  }

  .hours dt {
    font-weight: 500;
  }

  .hours dd {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
