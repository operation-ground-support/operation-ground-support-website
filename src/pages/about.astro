---
/**
 * About — the page that does not exist on the current site, and the structural hole that most
 * likely cost the funding application.
 *
 * Everything a grant reviewer's diligence checklist asks for lives here or in the transparency
 * bar: who runs this, is the 501(c)(3) real, what has been done, where the money goes, and what
 * the relationship with the host congregation actually is. Board list, EIN, and one honest
 * number would move further with a funder than any amount of redesign.
 *
 * The sections below render only when the underlying facts exist, so this page is currently
 * mostly gaps. Those gaps are the worklist; run `just audit`.
 */
import Base from '../layouts/Base.astro'
import MetricRow from '../components/MetricRow.astro'
import Photo from '../components/Photo.astro'
import Todo from '../components/Todo.astro'
import TaxCode from '../components/TaxCode.astro'
import { org } from '../data/org'
import { pick } from '../i18n/routes'
import { SHOW_MARKERS } from '../lib/markers'
import board_corrected from '../assets/photos/board_corrected.jpg'
import homelessnessSummit from '../assets/photos/homelessness-summit-4.jpg'

const locale = 'en' as const
const people = [
  { heading: 'Board', list: org.board },
  { heading: 'Staff and volunteers', list: org.staff },
].filter((group) => group.list.length > 0)

/** A bio is one paragraph or a list of them; see `Person` in org.ts. */
const paragraphs = (bio?: string | string[]) => (bio === undefined ? [] : [bio].flat())
---

<Base
  title="About"
  description={`Who runs ${org.name}, how it started, and where the money goes.`}
  locale={locale}
  pageKey="about"
  lastReviewed="2026-08-27"
>
  <h1>About</h1>
  <p class="lede">{org.mission}</p>

  <section class="section">
    <h2>Our history</h2>
    <p>
      We originally began as a medical support group, organized to provide support on the grounad to doctors treating people with heat exhaustion. It was there that we began to realize the plight of the unhoused. There are many implications of being homeless or just food insecure, that most people are completely unaware of. There are many who are living out of their car, who have many logistical difficulties that you would never think about unless hearing about it. There are many struggling families who would be greatly helped by organized food boxes with plenty of healthy foods. Thus we began branching out.
    </p>
  </section>

  {
    people.map((group) => (
      <section class="section">
        <h2>{group.heading}</h2>
        <ul class="people">
          {group.list.map((person) => (
            <li>
              <p class="person__name">{person.name}</p>
              <p class="person__role">{person.role}</p>
              {paragraphs(person.bio).map((paragraph) => (
                <p class="person__bio">{paragraph}</p>
              ))}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {/* Everyone pictured must be a volunteer, staff, or board member who agreed to it — never
      someone the organization serves. See the rules in Photo.astro. */}
  <Photo
    src={board_corrected}
    focus="center 30%"
    alt="TODO fix this. Seven people standing together in a large hall with folding tables and chairs. Five wear lime-green T-shirts reading “DFW Operation Ground Support”."
    caption="The board, May 30, 2026."
  />

  <section class="section">
    <h2>Tax status</h2>
    <p><TaxCode text={pick(org.taxStatus, locale)} /></p>
  </section>

  <Photo
    src={homelessnessSummit}
    alt="A woman speaking into a microphone beside a large screen showing a slide titled “Causes of Homelessness”, with banners standing behind her."
    caption="From the April 11, 2026 homelessness summit"
  />
</Base>

<style>
  .people {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-s);
    display: grid;
    gap: var(--space-m);
  }

  .person__name {
    font-weight: 500;
  }

  .person__role {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .person__bio {
    margin-block-start: var(--space-3xs);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .person__bio + .person__bio {
    margin-block-start: var(--space-2xs);
  }

  .filings {
    margin-block-start: var(--space-s);
    padding-inline-start: var(--space-m);
  }

  .filings li + li {
    margin-block-start: var(--space-3xs);
  }
</style>
