---
/**
 * Donate — money, through the organization's Donorbox campaign.
 *
 * The form is Donorbox's own widget, the same embed the old Squarespace page used, so there is one
 * campaign to manage. The preset amounts, the monthly option, and the fee checkbox are all set in
 * the Donorbox dashboard, not here. It is the only third-party script on the site, and it loads on
 * this page alone.
 *
 * Inside `<dbox-widget>` is a plain link to the hosted campaign page. The widget draws into a
 * shadow root, which hides that link once it loads; if the script is blocked or the visitor is
 * offline, the link is what shows, so the page is never empty.
 */
import Base from '../layouts/Base.astro'
import Todo from '../components/Todo.astro'
import { org } from '../data/org'

const locale = 'en' as const

// The campaign is the path of its hosted page: `https://donorbox.org/operation-ground-support`.
const campaign = org.donate.url && new URL(org.donate.url).pathname.replaceAll('/', '')
---

<Base
  title="Donate"
  description={`Give money to ${org.name}, a 501(c)(3) serving neighbors in Dallas.`}
  locale={locale}
  pageKey="donate"
  lastReviewed="2026-10-24"
>
  <h1>Donate</h1>

  {
    org.donate.url ? (
      <>
        <div class="form">
          <script is:inline type="module" src="https://donorbox.org/widgets.js" async />
          <dbox-widget campaign={campaign} type="donation_form" enable-auto-scroll="true">
            <a class="button" href={org.donate.url} rel="noopener">
              Donate{org.donate.platform ? ` on ${org.donate.platform}` : ''}
            </a>
          </dbox-widget>
        </div>
        {/* This describes a setting in the Donorbox dashboard: the fee checkbox on the form, which
            is ticked by default. If that setting changes, change this paragraph with it. */}
        <p class="note">
          Note: Card payments carry a processing fee, and Donorbox adds a platform fee (typically ~5% in total). By default, there is a ticked option on the form to add both fees on top of your gift so that they do not come out of it.
        </p>
      </>
    ) : (
      <Todo label="No way to give money">
        Set <code>org.donate.url</code> in <code>src/data/org.ts</code> to the Donorbox campaign
        page.
      </Todo>
    )
  }
</Base>

<style>
  .form {
    margin-block-start: var(--space-l);
  }

  /* While the form loads, Donorbox shows a 500px placeholder positioned over the widget, which
     otherwise has no height yet and lets it cover the note below. Reserving that height also stops
     the note jumping when the form arrives. `:defined` waits for the script, so the fallback link
     does not sit above 500px of nothing when the script never comes. */
  dbox-widget:defined {
    display: block;
    position: relative;
    min-height: 500px;
  }

  .note {
    margin-block-start: var(--space-m);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
