---
/**
 * Spanish homepage.
 *
 * Shorter than the English one, because Get help and Contact are the only pages translated so
 * far. The other doors still open — onto the English pages, marked "EN" — so a Spanish speaker
 * can at least discover that the organization takes volunteers. As pages get translated, filling
 * in `routes.ts` swaps those links over here and in the nav with no other change.
 */
import Base from '../../layouts/Base.astro'
import Doors from '../../components/Doors.astro'
import Hours from '../../components/Hours.astro'
import { path } from '../../i18n/routes'

const locale = 'es' as const
---

<Base
  title="Inicio"
  description="Operation Ground Support reparte ropa, comida, artículos de higiene y artículos del hogar sin costo en Old East Dallas."
  locale={locale}
  pageKey="home"
  lastReviewed="2026-08-27"
>
  <p class="eyebrow">Old East Dallas</p>
  <h1 class="statement">(TODO this needs to be updated to match the English one) Ropa, comida y artículos de primera necesidad, sin costo, para nuestros vecinos.</h1>

  <p class="lede">
    Recibimos donaciones y las entregamos a quien las necesite, en el sótano de.
  </p>

  <Doors locale={locale} />

  <section class="section">
    <h2>Dónde estamos</h2>
    <Hours locale={locale} />
    <p><a href={path('contact', locale)!}>Contacto</a></p>
  </section>
</Base>

<style>
  .statement {
    font-size: var(--text-display);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-block-start: var(--space-2xs);
    max-width: 20ch;
  }

  .lede {
    margin-block-start: var(--space-m);
  }

  .section {
    margin-block-start: var(--space-2xl);
  }
</style>
