---
/**
 * TODO delete this?
 * Drop off — physical goods only. Money lives on `/donate`.
 *
 * The split is by *act*, not by generosity: dropping off goods needs an address, hours, and a
 * list of what is short, and giving money needs none of those. Keeping them together meant the
 * page had to serve a person in a car and a person on a phone at the same time, and did neither
 * well. The old Squarespace site had the opposite problem — drop-off logistics repeated nearly
 * verbatim across two pages, and no way to give money at all.
 *
 * This page is named for the verb a donor would use. It is deliberately not called "Give", which
 * would be indistinguishable from "Donate" in the navigation.
 */
import Base from '../layouts/Base.astro'
import Hours from '../components/Hours.astro'
import NeedsList from '../components/NeedsList.astro'
import Photo from '../components/Photo.astro'
import PhotoSlot from '../components/PhotoSlot.astro'
import { org } from '../data/org'
import { path } from '../i18n/routes'
import clothingRoom from '../assets/photos/clothing-room.jpg'
import foodBoxes from '../assets/photos/food-boxes-2.jpg'

const locale = 'en' as const
---

<Base
  title="Drop off"
  description="Drop off clothing, food, hygiene supplies, and household goods at Grace United Methodist Church in Old East Dallas."
  locale={locale}
  pageKey="dropOff"
  lastReviewed="2026-08-27"
>
  <h1>Drop off</h1>

  <NeedsList locale={locale} level="h2" />

  <section class="section">
    <h2>Dropping off</h2>
    <br>
    <p>
      Clothing may be new or used, except for underwear and hygiene products which must only be new and unopened.
      <br>
      We are working on getting permanent locations and times that can be listed here, for now email
      {' '}<a href={`mailto:${org.email}`}>{org.email}</a> for asking about drop off.
    </p>
  </section>

  <Photo
    src={foodBoxes}
    alt="A folding table covered with groceries: melons, tomatoes, orange peppers, apples, bananas, onions, bags of potatoes and dried beans, bottles of cooking oil, and canned fruit."
    caption="Assembling sets of goods for food boxes to send directly to families"
  />

  <Photo
    src={clothingRoom}
    alt="Clothing hung on racks and folded on black shelving, shoes on wire racks along both walls, and yellow tape marking aisles on the floor."
    caption="A clothing room in Grace UMC run by one of our partners, January 2026"
  />

  {
    org.registryUrl && (
      <section class="section">
        <h2>Wish list</h2>
        <p>
          If you would rather ship something directly,
          {' '}<a href={org.registryUrl} rel="noopener">our wish list</a> stays in sync with what is short.
        </p>
      </section>
    )
  }
</Base>

<style>
  .steps {
    margin-block-start: var(--space-s);
    padding-inline-start: var(--space-m);
  }

  .steps li + li {
    margin-block-start: var(--space-2xs);
  }

  .note {
    margin-block-start: var(--space-s);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .aside {
    margin-block-start: var(--space-s);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
