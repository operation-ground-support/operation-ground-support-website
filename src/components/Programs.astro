---
/**
 * What the organization does, as a numbered list.
 *
 * Ten items is a lot, and the obvious treatment — a grid of cards with an icon each — is the one
 * thing this site does not do. It would need ten icons nobody has drawn, it would make ten
 * different programs look like ten identical products, and it is the house style of every thin
 * nonprofit site this one is trying not to resemble. A numbered list says the same thing with
 * more authority: it reads as an inventory, which is what it is, and its length is the argument.
 *
 * The count in the heading is derived, not typed. An eleventh program added to `org.ts` without
 * the subheading being updated would otherwise leave "Ten ways" sitting above eleven of them —
 * the same silent staleness the rest of the build guards against.
 */
import { org } from '../data/org'

const COUNT_WORDS = [
  'No',
  'One',
  'Two',
  'Three',
  'Four',
  'Five',
  'Six',
  'Seven',
  'Eight',
  'Nine',
  'Ten',
  'Eleven',
  'Twelve',
]
const n = org.programs.length
const count = COUNT_WORDS[n] ?? String(n)
---

{
  org.programs.length > 0 && (
    <section class="programs wide">
      <h2>What we do</h2>
      <p class="programs__sub">{count} ways we bridge the gap</p>

      <ol class="programs__list">
        {org.programs.map((p) => (
          <li class="programs__item">
            <h3 class="programs__name">{p.name}</h3>
            <p class="programs__desc">{p.description}</p>
            <p class="programs__tag">{p.tag}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .programs {
    margin-block-start: var(--space-2xl);
  }

  .programs__sub {
    font-family: var(--font-serif), Georgia, serif;
    font-size: var(--text-xl);
    color: var(--ink-muted);
    margin-block-start: var(--space-3xs);
  }

  .programs__intro {
    max-width: var(--measure);
    margin-block-start: var(--space-s);
    color: var(--ink-muted);
  }

  /* Two columns only when there is genuinely room for two reading measures. Below that the
     numbers would be doing more work than the text. */
  .programs__list {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-l);
    counter-reset: program;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }

  @media (min-width: 56rem) {
    .programs__list {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-xl);
    }
  }

  /* The rule is the only container. No border box, no background, no radius — the list reads as
     a document, and a hairline is enough to separate one entry from the next.
     A two-column grid rather than an indent: `ch` resolves against each element's own font size,
     so a number, a heading and a caption set at three different sizes would each land on a
     different left edge. The grid track is one shared measurement, so they cannot drift — and it
     leaves room for a two-digit number without the tenth item colliding with its own heading. */
  .programs__item {
    counter-increment: program;
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
  }

  .programs__item::before {
    content: counter(program);
    grid-column: 1;
    grid-row: 1;
    font-family: var(--font-sans), system-ui, sans-serif;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  .programs__name,
  .programs__desc,
  .programs__tag {
    grid-column: 2;
  }

  .programs__name {
    font-size: var(--text-base);
    line-height: 1.3;
    margin: 0;
  }

  .programs__desc {
    margin-block-start: var(--space-2xs);
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .programs__tag {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
