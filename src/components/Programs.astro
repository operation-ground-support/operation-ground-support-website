---
/**
 * What the organization does, as a numbered list.
 *
 * Eight items is a lot, and the obvious treatment — a grid of cards with an icon each — is the one
 * thing this site does not do. It would need eight icons nobody has drawn, it would make eight
 * different programs look like eight identical products, and it is the house style of every thin
 * nonprofit site this one is trying not to resemble. A numbered list says the same thing with
 * more authority: it reads as an inventory, which is what it is, and its length is the argument.
 *
 * The count in the heading is derived, not typed. A ninth program added to `org.ts` without the
 * subheading being updated would otherwise leave "Eight ways" sitting above nine of them — the
 * same silent staleness the rest of the build guards against.
 */
import { org } from '../data/org'
import { pick, type Locale } from '../i18n/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const text = {
  heading: { en: 'What We Do', es: 'Lo que hacemos' },
  sub: { en: 'ways we bridge the gap', es: 'formas de cerrar la brecha' },
  countWords: {
    en: ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'],
    es: ['Ninguna', 'Una', 'Dos', 'Tres', 'Cuatro', 'Cinco', 'Seis', 'Siete', 'Ocho', 'Nueve', 'Diez', 'Once', 'Doce'],
  },
}

const n = org.programs.length
const count = pick(text.countWords, locale)[n] ?? String(n)
---

{
  org.programs.length > 0 && (
    <section class="programs wide">
      <h2>{pick(text.heading, locale)}</h2>
      <p class="programs__sub">{count} {pick(text.sub, locale)}</p>

      <ol class="programs__list">
        {org.programs.map((p) => (
          <li class="programs__item">
            <h3 class="programs__name">{pick(p.name, locale)}</h3>
            <p class="programs__desc">{pick(p.description, locale)}</p>
            <p class="programs__tag">{pick(p.tag, locale)}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .programs {
    margin-block-start: var(--space-2xl);
  }

  .programs__sub {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    margin-block-start: var(--space-2xs);
  }

  /* Two columns only when there is genuinely room for two reading measures. Below that the
     numbers would be doing more work than the text. */
  .programs__list {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-l);
    counter-reset: program;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }

  @media (min-width: 56rem) {
    .programs__list {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-xl);
    }
  }

  /* The rule is the only container. No border box, no background, no radius — the list reads as
     a document, and a hairline is enough to separate one entry from the next.
     A two-column grid rather than an indent: `ch` resolves against each element's own font size,
     so a number, a heading and a caption set at three different sizes would each land on a
     different left edge. The grid track is one shared measurement, so they cannot drift — and it
     leaves room for a two-digit number without the tenth item colliding with its own heading. */
  .programs__item {
    counter-increment: program;
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
  }

  .programs__item::before {
    content: counter(program);
    grid-column: 1;
    grid-row: 1;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .programs__name,
  .programs__desc,
  .programs__tag {
    grid-column: 2;
  }

  .programs__name {
    font-size: var(--text-xl);
    line-height: 1;
    margin: 0;
  }

  .programs__desc {
    margin-block-start: var(--space-2xs);
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .programs__tag {
    margin-block-start: var(--space-2xs);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
