---
/**
 * The homepage, shared by `/` and `/es`.
 *
 * The largest thing on this page is a sentence, not a photograph. That is the central design
 * decision of the site: restraint reads as sophistication in this sector, a typographic opening
 * survives the logo not being finished, and it means the page needs one good photograph instead
 * of five.
 *
 * One body for both languages, like `ContactBody.astro`, so the Spanish homepage cannot fall
 * behind the English one structurally. The prose comes from `org.ts`, already in both languages.
 */
import BridgeChain from './BridgeChain.astro'
import CallToAction from './CallToAction.astro'
import Programs from './Programs.astro'
import TaxCode from './TaxCode.astro'
import MetricRow from './MetricRow.astro'
import EventList from './EventList.astro'
import { org } from '../data/org'
import { navLink, pick, type Locale } from '../i18n/routes'
import { getCollection } from 'astro:content'
import { formatDate } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const text = {
  eyebrow: { en: 'Dallas, Texas', es: 'Dallas, Texas' },
  recent: { en: 'Recent updates', es: 'Novedades recientes' },
  all: { en: 'All updates', es: 'Todas las novedades' },
}

// Posts are written in one language and not auto-translated, so each homepage lists its own.
const updates = (await getCollection('updates', ({ data }) => !data.draft && data.lang === locale))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2)

const allUpdates = navLink('updates', locale)
---

<p class="eyebrow">{pick(text.eyebrow, locale)}</p>
<h1 class="statement">{pick(org.tagline, locale)}</h1>

{/* The mission leads the paragraph rather than the page: it is the sentence that names the
    organization and its 501(c)(3) status, so a reviewer still meets it first. */}
<p class="lede"><TaxCode text={pick(org.mission, locale)} /> {pick(org.lede, locale)}</p>

{/* Above the programs on purpose. Someone who already knows this organization comes back to
    find out when the next distribution is, and a dated list of real events is more convincing
    to a first-time reader than any description of what the organization does. */}
<EventList locale={locale} />

<MetricRow locale={locale} />

{/* Just above the programs: it is the model, and each program below is one way of doing it. */}
<BridgeChain locale={locale} />

<Programs locale={locale} />

{
  updates.length > 0 && (
    <section class="recent">
      <h2>{pick(text.recent, locale)}</h2>
      <ul>
        {updates.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {formatDate(post.data.date, locale)}
            </time>
            <a href={`/updates/${post.id}`}>{post.data.title}</a>
            <p>{post.data.summary}</p>
          </li>
        ))}
      </ul>
      <p>
        <a href={allUpdates.href} hreflang={allUpdates.isFallback ? allUpdates.lang : undefined}>
          {pick(text.all, locale)}
        </a>
      </p>
    </section>
  )
}

{/* Last on the page, and it has to stay last: it pulls itself down to meet the footer. */}
<CallToAction locale={locale} />

<style>
  /* The place name, as a cobalt tag, answering the cobalt band that closes the page. */
  .eyebrow {
    display: inline-block;
    justify-self: start;
    background: var(--accent);
    color: var(--paper);
    padding: 0.2em 0.6em;
  }

  /* The tagline, at the largest size on the site and in the stencil face, which appears only here
     and in the closing band. It is short enough for display size; a longer sentence here would
     need a step down. If the sentence or `--measure` changes, re-check the line count. */
  .statement {
    font-family: var(--font-headline), Impact, 'Arial Narrow', sans-serif;
    font-size: var(--text-display);
    font-weight: 900;
    line-height: 0.9;
    margin-block-start: var(--space-s);
    text-wrap: balance;
  }

  .lede {
    margin-block-start: var(--space-m);
  }

  .recent {
    margin-block-start: var(--space-2xl);
  }

  .recent ul {
    list-style: none;
    padding: 0;
    margin-block: var(--space-m);
  }

  .recent li {
    padding-block: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }

  .recent time {
    display: block;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .recent a {
    font-weight: 500;
  }

  .recent p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-3xs);
  }
</style>
