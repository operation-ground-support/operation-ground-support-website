---
/**
 * Masthead and primary navigation.
 *
 * The wordmark is currently a text lockup, not an image. That is intentional until the bridge
 * logo exists as clean SVG: a 1124x114 PNG masthead is itself a small credibility tell, because
 * it means there is no vector source and no lockup system. Well-set type is a better placeholder
 * than a bad raster.
 *
 * When the SVG lands, replace the <a class="wordmark"> contents and nothing else changes.
 */
import { useTranslations } from '../i18n/ui'
import { NAV_ORDER, navLink, path, type Locale, type PageKey } from '../i18n/routes'

interface Props {
  locale: Locale
  pageKey: PageKey
}

const { locale, pageKey } = Astro.props
const t = useTranslations(locale)

const navLabels: Record<PageKey, ReturnType<typeof t>> = {
  home: t('nav.getHelp'), // unused; home is the wordmark
  getHelp: t('nav.getHelp'),
  give: t('nav.give'),
  volunteer: t('nav.volunteer'),
  about: t('nav.about'),
  updates: t('nav.updates'),
  contact: t('nav.contact'),
}

// Untranslated pages still appear, pointing at the canonical English URL and marked "EN". The
// alternative — omitting them — means a Spanish speaker cannot discover that the organization
// takes volunteers at all, and that is a worse failure than a language barrier the visitor can
// see coming. What is never done is serving English content under an /es/ path; see `navLink`.
// Fallback links get `hreflang` but deliberately not `lang`: the label stays in the reader's
// language, so claiming the anchor's own text is English would make a screen reader pronounce
// "Voluntariado" with English phonetics. Only the destination differs.
const items = NAV_ORDER.map((key) => ({ ...navLink(key, locale), label: navLabels[key] }))

const homeHref = path('home', locale) ?? '/'
---

<header class="masthead full">
  <div class="masthead__inner">
    <a class="wordmark" href={homeHref}>
      <span class="wordmark__line1">Operation</span>
      <span class="wordmark__line2">Ground Support</span>
    </a>

    <nav aria-label={t('a11y.mainNav')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.key === pageKey ? 'page' : undefined}
                hreflang={item.isFallback ? item.lang : undefined}
              >
                {item.label}
                {item.isFallback && (
                  <>
                    {' '}
                    <span class="nav__badge" aria-hidden="true">{t('nav.langBadge')}</span>
                    <span class="visually-hidden">({t('nav.inOtherLanguage')})</span>
                  </>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-block-end: 1px solid var(--rule);
  }

  .masthead__inner {
    max-width: var(--shell);
    margin-inline: auto;
    padding: var(--space-m) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .wordmark {
    font-family: var(--font-serif), Georgia, serif;
    font-weight: 600;
    font-size: var(--text-xl);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
    display: grid;
  }

  .wordmark__line1 {
    font-size: 0.72em;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 400;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  nav a {
    color: var(--ink-muted);
    text-decoration: none;
    padding-block: var(--space-3xs);
    border-block-end: 2px solid transparent;
  }

  nav a:hover {
    color: var(--ink);
    border-block-end-color: var(--rule-strong);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-block-end-color: var(--accent);
  }

  /* Marks a link whose page exists only in English. Small and quiet — it is an advisory, not a
     warning, and the visitor should be able to ignore it if they read English fine. */
  .nav__badge {
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0 0.25em;
    vertical-align: 0.12em;
  }

  /* No hamburger. Six short links wrap onto two lines on a phone, which is less machinery and
     one fewer thing that can break than a JavaScript menu. */
  @media (max-width: 40rem) {
    .masthead__inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-s);
    }
    nav ul {
      gap: var(--space-s) var(--space-m);
    }
  }
</style>
