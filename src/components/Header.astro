---
/**
 * Masthead and primary navigation.
 *
 * The wordmark is the road-sign logo from the van magnet (`src/assets/logo/sign.svg`), which is
 * the secondary mark while the bridge logo is still being drawn. When that lands, swap the import
 * and the height below; nothing else here depends on which mark it is.
 *
 * An <img> rather than the inline SVG component: the file is the same on every page, so the
 * browser caches it once, and `alt` gives the home link its accessible name.
 */
import sign from '../assets/logo/sign.svg'
import { org } from '../data/org'
import { useTranslations } from '../i18n/ui'
import { NAV_EMPHASIS, NAV_ORDER, navLink, path, type Locale, type PageKey } from '../i18n/routes'

interface Props {
  locale: Locale
  pageKey: PageKey
}

const { locale, pageKey } = Astro.props
const t = useTranslations(locale)

const navLabels: Record<PageKey, ReturnType<typeof t>> = {
  home: t('nav.partners'), // unused; home is the wordmark
  partners: t('nav.partners'),
  donate: t('nav.donate'),
  volunteer: t('nav.volunteer'),
  about: t('nav.about'),
  updates: t('nav.updates'),
  contact: t('nav.contact'),
}

// Untranslated pages still appear, pointing at the canonical English URL and marked "EN". The
// alternative — omitting them — means a Spanish speaker cannot discover that the organization
// takes volunteers at all, and that is a worse failure than a language barrier the visitor can
// see coming. What is never done is serving English content under an /es/ path; see `navLink`.
// Fallback links get `hreflang` but deliberately not `lang`: the label stays in the reader's
// language, so claiming the anchor's own text is English would make a screen reader pronounce
// "Voluntariado" with English phonetics. Only the destination differs.
const items = NAV_ORDER.map((key) => ({
  ...navLink(key, locale),
  label: navLabels[key],
  emphasis: NAV_EMPHASIS[key],
}))

const homeHref = path('home', locale) ?? '/'
---

<header class="masthead full">
  <div class="masthead__inner">
    <a class="wordmark" href={homeHref}>
      <img src={sign.src} width={sign.width} height={sign.height} alt={org.name} />
    </a>

    <nav aria-label={t('a11y.mainNav')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[item.emphasis && `nav__action nav__action--${item.emphasis}`]}
                aria-current={item.key === pageKey ? 'page' : undefined}
                hreflang={item.isFallback ? item.lang : undefined}
              >
                {item.label}
                {item.isFallback && (
                  <>
                    {' '}
                    <span class="nav__badge" aria-hidden="true">{t('nav.langBadge')}</span>
                    <span class="visually-hidden">({t('nav.inOtherLanguage')})</span>
                  </>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead {
    background: var(--paper);
    border-block-end: 2px solid var(--ink);
  }

  /* The masthead stays at the top of the window as the page scrolls, so Donate and Volunteer are
     always in reach; the transparency bar above it scrolls away. Only from 56rem, where it fits on
     one row: on a phone it is three rows tall and would hold down a third of the screen. The
     in-page jump offset that goes with this is `scroll-padding-top` in global.css. */
  @media (min-width: 56rem) {
    .masthead {
      position: sticky;
      top: 0;
      z-index: 50;
    }
  }

  .masthead__inner {
    max-width: var(--shell);
    margin-inline: auto;
    padding: var(--space-xs) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  /* Sized by height so the sign lines up with the nav row. At 4rem the lettering is about 13px
     tall, which is as small as the sign stays comfortably legible. */
  .wordmark {
    --sign-height: 4rem;
    display: block;
    /* The sign's corner is 42 of its 504 units, so the focus ring follows its rounded corners
       instead of cutting across them. */
    border-radius: calc(var(--sign-height) * 42 / 504);
  }

  .wordmark img {
    display: block;
    height: var(--sign-height);
    width: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  /* The buttons carry their own padding, so the standard nav gap leaves the pair looking adrift
     from each other. Pull the second one back toward the first. */
  nav li:has(.nav__action) + li:has(.nav__action) {
    margin-inline-start: calc(var(--space-m) * -0.4);
  }

  /*
   * The underline treatment belongs to the plain text links only, and the `:not()` is load-bearing.
   *
   * Astro scopes `nav a` to `nav[data-astro-cid] a[data-astro-cid]` — specificity (0,2,2) — while
   * `.nav__action--outline[data-astro-cid]` is only (0,2,0). Without the exclusion the generic
   * rule wins, and its `border-block-end: 2px solid transparent` erases the buttons' bottom
   * border, leaving the outline open at the bottom.
   */
  nav a:not(.nav__action) {
    color: var(--ink);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: var(--space-3xs);
    border-block-end: 2px solid transparent;
  }

  nav a:not(.nav__action):hover,
  nav a:not(.nav__action)[aria-current='page'] {
    border-block-end-color: var(--signal);
  }

  /* Donate and Volunteer, rendered as the same solid/outline pair used by `.button` in
     global.css. Sized to the nav's own type scale so they read as emphasised links rather than
     as a marketing call-to-action bar bolted onto the masthead. */
  .nav__action {
    /* Inline boxes do not let vertical padding or borders affect line-box height, so the list
       item reserved no room for the button's own box. */
    display: inline-block;
    /* Excluded from the `nav a` rule above, so they need their own, or the global underline shows. */
    text-decoration: none;
    /* More below than above, for the reason given on `.button` in global.css. */
    padding: 0.35rem 0.9rem 0.45rem;
    border: 2px solid var(--signal);
    border-radius: var(--radius);
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  /* The same lift on hover as `.button` in global.css, except on the current page's button, which
     is marked by colour instead and stays put. */
  .nav__action:not([aria-current='page']):hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .nav__action--solid {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--signal-ink);
  }

  .nav__action--solid[aria-current='page'] {
    background: var(--signal-current);
    border-color: var(--signal-current);
  }

  .nav__action--outline {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }

  .nav__action--outline[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* Inside a solid button the badge has to borrow the button's foreground, or it disappears. */
  .nav__action--solid .nav__badge {
    color: color-mix(in srgb, var(--signal-ink) 78%, transparent);
    border-color: color-mix(in srgb, var(--signal-ink) 45%, transparent);
  }

  /* Marks a link whose page exists only in English. Small and quiet — it is an advisory, not a
     warning, and the visitor should be able to ignore it if they read English fine. */
  .nav__badge {
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0 0.25em;
    vertical-align: 0.12em;
  }

  /* No hamburger. Six short links wrap onto two lines on a phone, which is less machinery and
     one fewer thing that can break than a JavaScript menu. */
  @media (max-width: 40rem) {
    .masthead__inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-s);
    }
    nav ul {
      gap: var(--space-s) var(--space-m);
    }
  }
</style>
