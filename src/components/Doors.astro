---
/**
 * Audience triage: three doors, phrased in the visitor's own voice.
 *
 * A pantry homepage has audiences arriving with incompatible goals — someone who needs food,
 * someone with a car full of coats, someone with a free Saturday. Making them choose in their
 * own words is better information architecture than a single "Learn more".
 *
 * Deliberately not icon cards. Icon triptychs are the strongest single tell of a template site,
 * and an icon adds nothing to "I need help" that the words do not already carry.
 *
 * "I need help" is first. On the current site nothing at all is addressed to the people served;
 * everything speaks to donors and volunteers. Putting that door first is a service obligation,
 * and it also happens to tell a funder that this organization knows its community.
 */
import { useTranslations } from '../i18n/ui'
import { navLink, type Locale } from '../i18n/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

// As in the nav, a door whose page is not translated still opens — onto the English page, marked
// as such. "I need help" is the one that must never be a fallback, and it is fully translated.
// Four doors now that money and goods are separate acts. `hreflang` without `lang`, for the
// reason given in Header.astro.
//
// The two solid doors are the two the organization most needs a stranger to walk through — "I
// need help" because that is the service obligation and nobody currently addresses it, and
// "Donate money" because it is the one act with no logistics in the way. Emphasis matches the
// navigation so the same action does not look primary in one place and secondary in another.
const doors = [
  { ...navLink('getHelp', locale), label: t('cta.getHelp'), solid: true },
  { ...navLink('donate', locale), label: t('cta.donate'), solid: true },
  { ...navLink('dropOff', locale), label: t('cta.dropOff'), solid: false },
  { ...navLink('volunteer', locale), label: t('cta.volunteer'), solid: false },
]
---

<ul class="doors">
  {
    doors.map((door) => (
      <li>
        <a
          class:list={[door.solid && 'is-solid']}
          href={door.href}
          hreflang={door.isFallback ? door.lang : undefined}
        >
          {door.label}
          {door.isFallback && (
            <>
              {' '}
              <span class="doors__badge" aria-hidden="true">{t('nav.langBadge')}</span>
              <span class="visually-hidden">({t('nav.inOtherLanguage')})</span>
            </>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .doors {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .doors a {
    display: inline-block;
    padding: var(--space-xs) var(--space-m);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
    background: var(--paper);
    transition: border-color 120ms ease, background 120ms ease;
  }

  .doors a:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .doors a.is-solid {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .doors a.is-solid:hover {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
  }

  .doors a.is-solid .doors__badge {
    color: color-mix(in srgb, var(--paper) 78%, transparent);
    border-color: color-mix(in srgb, var(--paper) 45%, transparent);
  }

  .doors__badge {
    font-size: 0.7em;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0 0.25em;
    vertical-align: 0.1em;
  }
</style>
