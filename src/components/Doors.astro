---
/**
 * Audience triage: doors phrased in the visitor's own voice.
 *
 * Visitors arrive with different goals — someone with money to give, someone with a free
 * Saturday. Making them choose in their own words is better information architecture than a
 * single "Learn more".
 *
 * Deliberately not icon cards. Icon triptychs are the strongest single tell of a template site,
 * and an icon adds nothing to "Donate money" that the words do not already carry.
 */
import { useTranslations } from '../i18n/ui'
import { navLink, type Locale } from '../i18n/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

// As in the nav, a door whose page is not translated still opens — onto the English page, marked
// as such. `hreflang` without `lang`, for the reason given in Header.astro.
//
// "Donate money" is solid because it is the one act with no logistics in the way. Emphasis
// matches the navigation so the same action does not look primary in one place and secondary in
// another.
const doors = [
  { ...navLink('donate', locale), label: t('cta.donate'), solid: true },
  { ...navLink('volunteer', locale), label: t('cta.volunteer'), solid: false },
]
---

<ul class="doors">
  {
    doors.map((door) => (
      <li>
        <a
          class:list={['button', !door.solid && 'button--quiet']}
          href={door.href}
          hreflang={door.isFallback ? door.lang : undefined}
        >
          {door.label}
          {door.isFallback && (
            <>
              {' '}
              <span class="doors__badge" aria-hidden="true">{t('nav.langBadge')}</span>
              <span class="visually-hidden">({t('nav.inOtherLanguage')})</span>
            </>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .doors {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  /* The doors themselves are styled by the global `.button` / `.button--quiet` pair, not by a
     third look of their own — see the comment on `.button` in global.css. Only the "EN" badge
     is local. */
  .doors__badge {
    font-size: 0.7em;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0 0.25em;
    vertical-align: 0.1em;
  }

  /* Inside a solid button the badge has to borrow the button's foreground, or it disappears. */
  .button:not(.button--quiet) .doors__badge {
    color: color-mix(in srgb, var(--signal-ink) 78%, transparent);
    border-color: color-mix(in srgb, var(--signal-ink) 45%, transparent);
  }
</style>
