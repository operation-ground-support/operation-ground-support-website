---
/**
 * The dated "what we need right now" list.
 *
 * Rendered from the newest file in `src/content/needs/`. The file's date is not shown on the page,
 * but it still picks which list is current, and `just audit` warns when it goes stale.
 */
import { getCollection, type CollectionEntry } from 'astro:content'
import { useTranslations } from '../i18n/ui'
import { tr, type Translatable } from '../i18n/content'
import type { Locale } from '../i18n/routes'

interface Props {
  locale: Locale
  /**
   * Heading level to render, so this can sit under an h1 or an h2 without breaking the outline.
   * Not called `as`: a prop by that name stops Astro wiring `Props` to `Astro.props`, and the
   * component's props then go unchecked without any error saying so.
   */
  level?: 'h2' | 'h3'
}

const { locale, level = 'h2' } = Astro.props
const t = useTranslations(locale)

const all = await getCollection('needs')
const latest = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0]

type Item = CollectionEntry<'needs'>['data']['categories'][number]['items'][number]

/**
 * An item is either bare text — `Rice`, or `{ en: Rice, es: Arroz }` — or an object carrying
 * `urgent` and an optional `note`. Only the second shape has a `name` key.
 */
function normalize(item: Item): { name: Translatable; urgent: boolean; note?: Translatable } {
  if (typeof item === 'object' && 'name' in item) return item
  return { name: item, urgent: false }
}

const Heading = level
const heading = t('needs.heading')
---

{
  latest ? (
    <section class="needs">
      {/* An empty heading would still be announced by a screen reader, so leave it out entirely. */}
      {heading && <Heading id="needs" class="needs__head">{heading}</Heading>}

      <div class="needs__grid">
        {latest.data.categories.map((category) => (
          <div class="needs__category">
            <h3 class="needs__categoryName">{tr(category.name, locale)}</h3>
            <ul>
              {category.items.map((raw) => {
                const item = normalize(raw)
                return (
                  <li class={item.urgent ? 'is-urgent' : undefined}>
                    {tr(item.name, locale)}
                    {item.note && <span class="needs__note"> — {tr(item.note, locale)}</span>}
                    {item.urgent && <span class="visually-hidden"> ({t('needs.urgent')})</span>}
                  </li>
                )
              })}
            </ul>
          </div>
        ))}
      </div>

      {latest.data.notNeeded.length > 0 && (
        <p class="needs__not">
          <span class="eyebrow">{t('needs.notNeeded')}</span>{' '}
          {latest.data.notNeeded.map((n) => tr(n, locale)).join(', ')}.
        </p>
      )}
    </section>
  ) : (
    <p>{t('needs.empty')}</p>
  )
}

<style>
  .needs__head {
    padding-block-end: var(--space-2xs);
    border-block-end: 1px solid var(--rule-strong);
  }

  .needs__grid {
    margin-block-start: var(--space-m);
    display: grid;
    gap: var(--space-m) var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .needs__categoryName {
    font-size: var(--text-base);
    font-family: var(--font-sans), system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin-block-end: var(--space-3xs);
  }

  .needs__category ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .needs__category li {
    padding-block: 1px;
  }

  /* The urgent marker is a rule, not a colour block or an icon. It reads as an editorial mark
     rather than a badge, and it survives being printed in black and white for a bulletin. */
  .needs__category li.is-urgent {
    color: var(--ink);
    font-weight: 500;
    box-shadow: inset 3px 0 0 var(--alert);
    padding-inline-start: var(--space-2xs);
    margin-inline-start: calc(var(--space-2xs) * -1);
  }

  .needs__note {
    color: var(--ink-faint);
  }

  .needs__not {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
