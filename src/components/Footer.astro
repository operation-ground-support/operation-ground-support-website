---
/**
 * The footer repeats the identity facts
 */
import { org } from '../data/org'
import { useTranslations } from '../i18n/ui'
import { path, pick, type Locale } from '../i18n/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const address = [org.postal_address.street, `${org.postal_address.city}, ${org.postal_address.state} ${org.postal_address.zip ?? ''}`.trim()]
  .filter(Boolean)
  .join(' · ')

const latestFiling = org.filings.length > 0 ? org.filings[0] : null
---

<footer class="footer full">
  <div class="footer__inner">
    <div class="footer__col">
      <p class="footer__name">{org.name}</p>
      <p class="footer__muted">{pick(org.tagline, locale)}</p>
    </div>

    <div class="footer__col">
      <h2 class="eyebrow">{t('footer.contact')}</h2>
      <p><a href={`mailto:${org.email}`}>{org.email}</a></p>
      {org.phone && (
        <p><a href={`tel:${org.phone.replace(/[^0-9+]/g, '')}`}>{org.phone}</a></p>
      )}
      {org.postal_address.street && (
        <p class="footer__muted">
          {org.postal_address.mapUrl ? <a href={org.postal_address.mapUrl} rel="noopener">{address}</a> : address}
        </p>
      )}
    </div>

    <div class="footer__col">
      <h2 class="eyebrow">{t('footer.transparency')}</h2>
      <ul>
        {org.determinationLetter && <li><a href={org.determinationLetter}>{t('bar.determination')}</a></li>}
        {latestFiling && <li><a href={latestFiling.href}>{t('bar.financials')} ({latestFiling.year})</a></li>}
        {org.candidUrl && <li><a href={org.candidUrl} rel="noopener">{t('bar.candid')}</a></li>}
        {org.annualReport && <li><a href={org.annualReport}>Annual report</a></li>}
        {path('about', locale) && <li><a href={path('about', locale)!}>{t('nav.about')}</a></li>}
      </ul>
      {org.ein && <p class="footer__ein">{t('bar.ein')} {org.ein}</p>}
    </div>
  </div>

  <div class="footer__inner footer__legal">
    <p>
      <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener">
        {t('footer.license')}
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper-sunk);
    border-block-start: 1px solid var(--rule);
    font-size: var(--text-sm);
    padding-block: var(--space-xl);
  }

  .footer__ein {
    margin-block-start: var(--space-xs);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  /* The licence line, under the three columns. No copyright notice above it on purpose: the
     rights are granted here, and "all rights reserved" would contradict the grant as well as
     being a dead formality — it has meant nothing in US law since Berne took effect in 1989. */
  .footer__legal {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--rule);
    display: block;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .footer__inner {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .footer__name {
    font-family: var(--font-serif), Georgia, serif;
    font-weight: 600;
    font-size: var(--text-lg);
  }

  .footer__muted {
    color: var(--ink-muted);
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__col :global(.eyebrow) {
    margin-block-end: var(--space-2xs);
    display: block;
  }

  .footer__col li + li,
  .footer__col p + p {
    margin-block-start: var(--space-3xs);
  }
</style>
