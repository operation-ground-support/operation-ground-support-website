---
/**
 * The open hours, from `org.dropOff.hours`.
 *
 * The same list appears on five pages — both homepages, Get help, Drop off, and Contact. It was
 * five hand-copied `<dl>`s with five copies of their styles, which is five places for the layout
 * to drift and five places to touch when a sixth day is added. Now it is one.
 */
import { org } from '../data/org'
import { pick, type Locale } from '../i18n/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const hours = org.dropOff.hours
---

{
  hours.length > 0 && (
    <dl class="hours">
      {hours.map((h) => (
        <div>
          <dt>{pick(h.days, locale)}</dt>
          <dd>{pick(h.time, locale)}</dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .hours {
    margin-block: var(--space-s);
    display: grid;
    gap: var(--space-3xs) var(--space-m);
    grid-template-columns: max-content 1fr;
    font-variant-numeric: tabular-nums;
  }

  /* `display: contents` lets each day and its time sit in the grid's two columns directly, so
     every row lines up without a table. */
  .hours > div {
    display: contents;
  }

  .hours dt {
    font-weight: 500;
  }

  .hours dd {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
