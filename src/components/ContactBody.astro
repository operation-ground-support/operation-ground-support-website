---
/**
 * Contact details, shared by `/contact` and `/es/contacto`.
 */
import { org } from '../data/org'
import Hours from './Hours.astro'
import { pick, type Locale } from '../i18n/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const text = {
  lede: {
    en: 'TODO Email is read daily. The phone reaches the church office during open hours.',
    es: 'El correo se revisa todos los días. El teléfono llega a la oficina de la iglesia durante el horario de atención.',
  },
  address: { en: 'Postal Address', es: 'Dirección' },
  map: { en: 'Open in maps', es: 'Ver en el mapa' },
  hours: { en: 'Open hours', es: 'Horario' },
  press: { en: 'Press and partnerships', es: 'Prensa y colaboraciones' },
  pressBody: {
    en: 'Reporters, congregations, and organizations looking to run a drive: use the same address and say so in the subject line.',
    es: 'Periodistas, congregaciones y organizaciones que quieran organizar una colecta: use la misma dirección e indíquelo en el asunto.',
  },
}
---

<p class="lede">{pick(text.lede, locale)}</p>

<ul class="contact">
  <li><a href={`mailto:${org.email}`}>{org.email}</a></li>
  {org.phone && <li><a href={`tel:${org.phone.replace(/[^0-9+]/g, '')}`}>{org.phone}</a></li>}
</ul>

<section class="section">
  <h2>{pick(text.address, locale)}</h2>
  <p class="address">
    {org.postal_address.street && <>{org.postal_address.street}<br /></>}
    {org.postal_address.city}, {org.postal_address.state} {org.postal_address.zip}
  </p>
  {org.postal_address.mapUrl && <p><a href={org.postal_address.mapUrl} rel="noopener">{pick(text.map, locale)}</a></p>}
</section>

<section class="section">
  <h2>{pick(text.hours, locale)}</h2>
  <Hours locale={locale} />
</section>

<section class="section">
  <h2>{pick(text.press, locale)}</h2>
  <p>{pick(text.pressBody, locale)}</p>
</section>

<style>
  .contact {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    font-size: var(--text-lg);
  }

  .contact li + li {
    margin-block-start: var(--space-3xs);
  }

  .address {
    margin-block-start: var(--space-s);
    line-height: var(--leading-snug);
  }
</style>
