---
/**
 * Contact details, shared by `/contact` and `/es/contacto`.
 */
import { addressLines, org } from '../data/org'
import Photo from './Photo.astro'
import { pick, type Locale } from '../i18n/routes'
import van from '../assets/photos/van.jpg'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const text = {
  lede: {
    en: 'Note: we are waiting on getting our final postal address.',
    es: 'Nota: todavía estamos esperando nuestra dirección postal definitiva.',
  },
  address: org.postal_address.street
    ? { en: 'Postal address', es: 'Dirección postal' }
    : { en: 'Location', es: 'Ubicación' },
  map: { en: 'Open in maps', es: 'Ver en el mapa' },
  vanAlt: {
    en: 'A silver minivan parked on a concrete drive beside a wooden fence, with a white rectangular sign on its front door reading “Operation Ground Support”.',
    es: 'Una minivan plateada estacionada en una entrada de concreto junto a una cerca de madera, con un letrero blanco rectangular en la puerta delantera que dice «Operation Ground Support».',
  },
  vanCaption: {
    en: 'Our van. The sign on its door is where the logo at the top of this page comes from.',
    es: 'Nuestra minivan. El logotipo de la parte superior de esta página viene del letrero de su puerta.',
  },
}
---

<p class="lede">{pick(text.lede, locale)}</p>

<ul class="contact">
  <li><a href={`mailto:${org.email}`}>{org.email}</a></li>
  {org.phone && <li><a href={`tel:${org.phone.replace(/[^0-9+]/g, '')}`}>{org.phone}</a></li>}
</ul>

<section class="section">
  <h2>{pick(text.address, locale)}</h2>
  <p class="address">
    {addressLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}
  </p>
  {org.postal_address.mapUrl && <p><a href={org.postal_address.mapUrl} rel="noopener">{pick(text.map, locale)}</a></p>}
</section>

<Photo src={van} alt={pick(text.vanAlt, locale)} caption={pick(text.vanCaption, locale)} />

<style>
  .contact {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    font-size: var(--text-lg);
  }

  .contact li + li {
    margin-block-start: var(--space-3xs);
  }

  .address {
    margin-block-start: var(--space-s);
    line-height: var(--leading-snug);
  }
</style>
