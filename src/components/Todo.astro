---
/**
 * A dev-only marker for content that is missing.
 *
 * Renders as a visible block during `just dev` and renders nothing in a production build. The
 * site therefore never ships a placeholder, but whoever is working on a page sees exactly what is
 * missing, in the place it belongs, rather than in a checklist somewhere else.
 *
 * `just audit` prints the same gaps for the fields it can see from `org.ts`.
 */
interface Props {
  /** Short label, e.g. "Answer needed". */
  label?: string
}

const { label = 'To do' } = Astro.props
const isDev = import.meta.env.DEV
---

{
  isDev && (
    <div class="todo" data-todo>
      <span class="eyebrow">{label}</span>
      <div><slot /></div>
    </div>
  )
}

<style>
  .todo {
    margin-block: var(--space-s);
    padding: var(--space-s) var(--space-m);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .todo :global(.eyebrow) {
    display: block;
    color: var(--alert);
    margin-block-end: var(--space-3xs);
  }
</style>
