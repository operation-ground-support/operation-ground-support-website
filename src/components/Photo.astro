---
/**
 * A photograph.
 *
 * `alt` and `caption` are both required, and that is the point. Requiring a caption forces every
 * image to earn its place by saying something specific — "the back door donors ring at" rather
 * than a mood shot. Layouts that treat photos as slots create demand for images nobody has, and
 * that demand is what pushes organizations toward stock and synthetic imagery.
 *
 * House rules for what goes through this component:
 *   - Real photographs only. Never AI-generated or stock imagery of people, shelves, or events.
 *     A generated image implying something happened is the one failure that discredits every
 *     other claim on the page.
 *   - No identifiable faces of the people served. This is a safety question, not only a dignity
 *     one, given who walks through that door. Volunteers can appear with a signed release.
 *   - Rooms, hands, shelves, boxes, doors, the parking lot. Unglamorous and specific reads as
 *     true; smiling-recipient photography reads as marketing.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  /** Import the image at the top of the page: `import shelves from '../assets/photos/x.jpg'`. */
  src: ImageMetadata
  /** Describes the image for someone who cannot see it. Not the same text as the caption. */
  alt: string
  /** Shown under the image. Say what this is and, where it matters, when. */
  caption: string
  /** Photographer credit, if not staff. */
  credit?: string
  /**
   * Crop a portrait shot to 4:3 like the landscape ones, keeping this part, as a CSS
   * `object-position`: `center 30%` keeps the band a little above the middle. Without it a
   * portrait is shown whole, narrower (see below).
   */
  focus?: string
  /** Set on the single most important image on a page so it is not lazy-loaded. */
  eager?: boolean
}

const { src, alt, caption, credit, focus, eager = false } = Astro.props

// The type requires a caption, but `''` satisfies it and ships an empty figcaption with a stray
// rule beside it. Refuse it here, where it is still a build error rather than a visual glitch.
if (caption.trim() === '') throw new Error(`Photo ${src.src} has an empty caption`)

/*
 * Most photos fill the full 82rem column. Two kinds are drawn narrower, and centred:
 *
 *   - A portrait shot with no `focus` is shown whole rather than cropped, at the width that makes
 *     it as tall as a 4:3 photo would be, so a tall picture does not take over the page.
 *   - An original narrower than the width it would be drawn at is drawn 30% smaller, so a small
 *     file is not stretched soft.
 *
 * On a screen narrower than the result, every photo fills the column.
 */
const whole = src.height > src.width && !focus
let scale = whole ? (3 / 4) * (src.width / src.height) : 1
if (src.width < 82 * 16 * scale) scale *= 0.7
const maxWidth = Math.round(82 * scale * 100) / 100

/*
 * How wide the image will be drawn, so the browser fetches a file that size rather than guessing.
 * 82rem is `--shell` from global.css, written out because `sizes` cannot read a CSS variable.
 * Change it if that token changes. Below that width the column fills the viewport, less a gutter
 * that `100vw` slightly overstates.
 */
const sizes = `(max-width: ${maxWidth + 6}rem) 100vw, ${maxWidth}rem`
---

<figure class:list={['photo', 'wide', whole && 'photo--whole']} style={`--photo-max: ${maxWidth}rem`}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1600, 2400]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={focus && `object-position: ${focus}`}
  />
  <figcaption>
    {caption}
    {credit && <span class="photo__credit">Photo: {credit}</span>}
  </figcaption>
</figure>

<style>
  .photo {
    margin-block: var(--space-l);
    width: min(100%, var(--photo-max));
    margin-inline: auto;
  }

  /* Every photograph spans the full width of the page and has the same shape, so a page with three
     of them reads as a set rather than a scrapbook. 4:3 is what a phone shoots, so almost nothing
     is cropped. A portrait is the exception, kept whole unless it has a `focus`. */
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    /* One consistent treatment across every photograph. Consistency is most of what separates
       "phone snapshots" from "photographed by someone with a point of view". Tune once, here. */
    filter: saturate(0.92) contrast(1.02);
    background: var(--paper-sunk);
  }

  .photo--whole :global(img) {
    aspect-ratio: auto;
  }

  figcaption {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
    border-inline-start: 2px solid var(--rule-strong);
    padding-inline-start: var(--space-2xs);
  }

  .photo__credit {
    display: block;
    color: var(--ink-faint);
    font-size: var(--text-xs);
  }
</style>
