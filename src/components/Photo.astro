---
/**
 * A photograph.
 *
 * `alt` and `caption` are both required, and that is the point. Requiring a caption forces every
 * image to earn its place by saying something specific — "the back door donors ring at" rather
 * than a mood shot. Layouts that treat photos as slots create demand for images nobody has, and
 * that demand is what pushes organizations toward stock and synthetic imagery.
 *
 * House rules for what goes through this component:
 *   - Real photographs only. Never AI-generated or stock imagery of people, shelves, or events.
 *     A generated image implying something happened is the one failure that discredits every
 *     other claim on the page.
 *   - No identifiable faces of the people served. This is a safety question, not only a dignity
 *     one, given who walks through that door. Volunteers can appear with a signed release.
 *   - Rooms, hands, shelves, boxes, doors, the parking lot. Unglamorous and specific reads as
 *     true; smiling-recipient photography reads as marketing.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  /** Import the image at the top of the page: `import shelves from '../assets/photos/x.jpg'`. */
  src: ImageMetadata
  /** Describes the image for someone who cannot see it. Not the same text as the caption. */
  alt: string
  /** Shown under the image. Say what this is and, where it matters, when. */
  caption: string
  /** Photographer credit, if not staff. */
  credit?: string
  /** `wide` lets the image breathe past the reading measure. Use at most once per page. */
  width?: 'content' | 'wide'
  /** Set on the single most important image on a page so it is not lazy-loaded. */
  eager?: boolean
}

const { src, alt, caption, credit, width = 'content', eager = false } = Astro.props

/*
 * How wide the image will be drawn, so the browser fetches a file that size rather than guessing.
 * These are `--measure` (42rem) and `--measure` plus both `--wide-track`s (82rem) from global.css,
 * written out because `sizes` cannot read a CSS variable. Change them if those tokens change.
 * Below that width the column fills the viewport, less a gutter that `100vw` slightly overstates.
 */
const sizes = width === 'wide' ? '(max-width: 88rem) 100vw, 82rem' : '(max-width: 48rem) 100vw, 42rem'
---

<figure class={width === 'wide' ? 'photo wide' : 'photo'}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1600, 2400]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  <figcaption>
    {caption}
    {credit && <span class="photo__credit">Photo: {credit}</span>}
  </figcaption>
</figure>

<style>
  .photo {
    margin-block: var(--space-l);
  }

  .photo :global(img) {
    width: 100%;
    /* One consistent treatment across every photograph. Consistency is most of what separates
       "phone snapshots" from "photographed by someone with a point of view". Tune once, here. */
    filter: saturate(0.92) contrast(1.02);
    background: var(--paper-sunk);
  }

  figcaption {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
    border-inline-start: 2px solid var(--rule-strong);
    padding-inline-start: var(--space-2xs);
  }

  .photo__credit {
    display: block;
    color: var(--ink-faint);
    font-size: var(--text-xs);
  }
</style>
