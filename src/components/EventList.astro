---
/**
 * Upcoming and past events.
 *
 * The awkward part of events on a static site: "upcoming" is computed when the site is built, so
 * a page built in August still calls an August event upcoming in September. Two mitigations,
 * both cheap:
 *
 *   1. Every item carries the ISO timestamp it ends at in `data-ends`, and a few lines of script
 *      move anything already over into the past list on load. No framework, no hydration.
 *   2. The deploy is rebuilt on a schedule so the no-JavaScript rendering is never far off.
 *      See `docs/operations.md`.
 *
 * This is the piece Squarespace gives you natively. Doing it by hand is the honest price of the
 * portability the rest of the stack buys.
 *
 * Every date and time here is rendered in Dallas time, deliberately and explicitly. `formatDate`
 * defaults to UTC, which is right for the date-only values elsewhere on the site (`2026-08-27`
 * is midnight UTC, and formatting it in Chicago would show the day before). An event is a moment,
 * not a date: 7 PM in Dallas is already tomorrow in UTC, so formatting an evening event's date in
 * UTC would print the next day beside the correct time, and someone would turn up a day late.
 */
import { getCollection } from 'astro:content'
import { useTranslations, formatDate } from '../i18n/ui'
import { tr } from '../i18n/content'
import type { Locale } from '../i18n/routes'

interface Props {
  locale: Locale
  /** Cap the upcoming list; the past list is always capped at 4. */
  limit?: number
}

const { locale, limit = 6 } = Astro.props
const t = useTranslations(locale)

/** Where every event happens. See the note above on why this is passed explicitly. */
const TZ = 'America/Chicago'

const now = Date.now()
const all = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.start.getTime() - b.data.start.getTime(),
)

const upcoming = all.filter((e) => (e.data.end ?? e.data.start).getTime() >= now).slice(0, limit)
const past = all.filter((e) => (e.data.end ?? e.data.start).getTime() < now).reverse().slice(0, 4)

function timeLabel(start: Date, end?: Date): string {
  const opts: Intl.DateTimeFormatOptions = { hour: 'numeric', minute: '2-digit', timeZone: TZ }
  const fmt = (d: Date) => new Intl.DateTimeFormat(locale === 'es' ? 'es-US' : 'en-US', opts).format(d)
  return end ? `${fmt(start)}–${fmt(end)}` : fmt(start)
}
---

<section class="events" data-events>
  <h2>{t('events.heading')}</h2>

  <ul class="events__list" data-list="upcoming">
    {
      upcoming.map((e) => (
        <li data-ends={(e.data.end ?? e.data.start).toISOString()}>
          <time datetime={e.data.start.toISOString()}>
            <span class="events__date">{formatDate(e.data.start, locale, { month: 'short', day: 'numeric', timeZone: TZ })}</span>
            <span class="events__time">{timeLabel(e.data.start, e.data.end)}</span>
          </time>
          <div>
            <p class="events__title">{tr(e.data.title, locale)}</p>
            {e.data.location && <p class="events__meta">{tr(e.data.location, locale)}</p>}
            {e.data.description && <p class="events__meta">{tr(e.data.description, locale)}</p>}
            {e.data.signUpUrl && <p><a href={e.data.signUpUrl} rel="noopener">{t('cta.volunteer')}</a></p>}
          </div>
        </li>
      ))
    }
  </ul>

  <p class="events__empty" data-empty hidden={upcoming.length > 0}>{t('events.none')}</p>

  {
    past.length > 0 && (
      <details class="events__past">
        <summary>{t('events.past')}</summary>
        <ul class="events__list" data-list="past">
          {past.map((e) => (
            <li>
              <time datetime={e.data.start.toISOString()}>
                <span class="events__date">{formatDate(e.data.start, locale, { month: 'short', day: 'numeric', timeZone: TZ })}</span>
              </time>
              <div>
                <p class="events__title">{tr(e.data.title, locale)}</p>
              </div>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</section>

<script>
  // Re-evaluate "upcoming" in the visitor's browser, so a stale build does not advertise an event
  // that already happened. Progressive enhancement: with scripting off, the build-time split
  // still applies and is at worst a few days out of date.
  for (const root of document.querySelectorAll('[data-events]')) {
    const upcoming = root.querySelector('[data-list="upcoming"]')
    const past = root.querySelector('[data-list="past"]')
    const empty = root.querySelector('[data-empty]')
    if (!upcoming) continue

    const now = Date.now()
    for (const item of Array.from(upcoming.querySelectorAll('li[data-ends]'))) {
      const ends = item.getAttribute('data-ends')
      if (ends && new Date(ends).getTime() < now) {
        if (past) past.prepend(item)
        else item.remove()
      }
    }
    if (empty) (empty as HTMLElement).hidden = upcoming.children.length > 0
  }
</script>

<style>
  /* Its own top margin, never borrowed from whatever precedes it, which may be a `PhotoSlot` or a
     `Todo` that production strips. Matches the homepage's `--space-2xl`. */
  .events {
    margin-block-start: var(--space-2xl);
  }

  .events__list {
    list-style: none;
    padding: 0;
    margin: var(--space-m) 0 0;
  }

  /* Wide enough for "Sep 26, 2026" and "10:00 AM–1:00 PM" each on one line. Below 34rem the date
     moves above the title instead, because a fixed column that wide on a phone would squeeze the
     description into a four-word ribbon. */
  .events__list li {
    display: grid;
    grid-template-columns: 8.25rem 1fr;
    gap: var(--space-m);
    padding-block: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }

  @media (max-width: 34rem) {
    .events__list li {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }

    .events__list time {
      display: flex;
      gap: var(--space-2xs);
      align-items: baseline;
    }
  }

  .events__date {
    display: block;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .events__time {
    display: block;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .events__title {
    font-weight: 500;
  }

  .events__meta {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .events__empty {
    color: var(--ink-muted);
    margin-block-start: var(--space-s);
  }

  .events__past {
    margin-block-start: var(--space-l);
    font-size: var(--text-sm);
  }

  .events__past summary {
    cursor: pointer;
    color: var(--ink-muted);
  }
</style>
