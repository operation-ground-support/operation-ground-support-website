---
/**
 * The page shell. Every page goes through here.
 *
 * `lastReviewed` is a required prop rather than an optional one on purpose: a page that nobody
 * will admit to having checked recently is exactly the page that goes stale and embarrasses the
 * organization in front of a funder. Making it required means a new page cannot be added without
 * someone dating it, and `just audit` reports the ones that have aged out.
 */
import { Font } from 'astro:assets'
import { org } from '../data/org'
import { useTranslations } from '../i18n/ui'
import type { Locale, PageKey } from '../i18n/routes'
import TransparencyBar from '../components/TransparencyBar.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  /** Page title, without the organization name — that is appended here. */
  title: string
  /** Meta description. One sentence, written for a human reading a search result. */
  description: string
  locale: Locale
  /** Which entry in the route table this page is, so nav and the language switcher work. */
  pageKey: PageKey
  /** ISO date (YYYY-MM-DD) when a human last confirmed this page is accurate. */
  lastReviewed: string
  /** Set for pages that should not appear in search results. */
  noindex?: boolean
}

const { title, description, locale, pageKey, lastReviewed, noindex = false } = Astro.props
const t = useTranslations(locale)

const fullTitle = pageKey === 'home' ? `${org.name}` : `${title} — ${org.name}`
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_US' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${org.name} — ${t('updates.heading')}`} href="/rss.xml" />

    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />

    {/* Machine-readable organization identity. Search engines and some grant-diligence tools
        read this; it costs nothing and it is one more place the EIN can be verified. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NGO',
      name: org.name,
      url: Astro.site?.href,
      email: org.email,
      ...(org.phone ? { telephone: org.phone } : {}),
      ...(org.ein ? { taxID: org.ein } : {}),
      ...(org.founded ? { foundingDate: org.founded } : {}),
      address: {
        '@type': 'PostalAddress',
        ...(org.location.street ? { streetAddress: org.location.street } : {}),
        addressLocality: org.location.city,
        addressRegion: org.location.state,
        ...(org.location.zip ? { postalCode: org.location.zip } : {}),
        addressCountry: 'US',
      },
    })} />
  </head>

  <body data-last-reviewed={lastReviewed}>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <TransparencyBar locale={locale} pageKey={pageKey} />
    <Header locale={locale} pageKey={pageKey} />
    <main id="main" class="layout">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
