---
/**
 * The page shell. Every page goes through here.
 *
 * `lastReviewed` is a required prop to prevent staleness
 */
import { Font } from 'astro:assets'
import { org } from '../data/org'
import { useTranslations } from '../i18n/ui'
import type { Locale, PageKey } from '../i18n/routes'
import TransparencyBar from '../components/TransparencyBar.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { isPlaceholder } from '../lib/placeholder'
import '../styles/global.css'

interface Props {
  /** Page title, without the organization name — that is appended here. */
  title: string
  /** Meta description. One sentence, written for a human reading a search result. */
  description: string
  locale: Locale
  /** Which entry in the route table this page is, so nav and the language switcher work. */
  pageKey: PageKey
  /** ISO date (YYYY-MM-DD) when a human last confirmed this page is accurate. */
  lastReviewed: string
  /** Set for pages that should not appear in search results. */
  noindex?: boolean
}

const { title, description, locale, pageKey, lastReviewed, noindex = false } = Astro.props
const t = useTranslations(locale)

const fullTitle = pageKey === 'home' ? `${org.name}` : `${title} — ${org.name}`
const canonical = new URL(Astro.url.pathname, Astro.site).href

/** A fact worth publishing as structured data: present, and not a placeholder standing in for one. */
const known = (value: string | null | undefined): value is string => Boolean(value) && !isPlaceholder(value)
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_US' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${org.name} — ${t('updates.heading')}`} href="/rss.xml" />

    {/* Preloaded only on pages keyed `home`: the stencil face sets the homepage headline and nothing else. */}
    <Font cssVariable="--font-headline" preload={pageKey === 'home'} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    {/* Not preloaded: it only sets small labels, and a moment in a fallback mono costs nothing. */}
    <Font cssVariable="--font-mono" />

    {/* Machine-readable organization identity. Search engines and some grant-diligence tools
        read this; it costs nothing and it is one more place the EIN can be verified.

        Every optional field goes through `known`, not a bare truthiness test. A placeholder is
        useful on the page, where a person reads it as a gap; here nobody reads it, and a scraper
        would record "(postal address TODO)" as this organization's street address. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NGO',
      name: org.name,
      url: Astro.site?.href,
      email: org.email,
      ...(known(org.phone) ? { telephone: org.phone } : {}),
      ...(known(org.ein) ? { taxID: org.ein } : {}),
      ...(known(org.founded) ? { foundingDate: org.founded } : {}),
      address: {
        '@type': 'PostalAddress',
        ...(known(org.postal_address.street) ? { streetAddress: org.postal_address.street } : {}),
        addressLocality: org.postal_address.city,
        addressRegion: org.postal_address.state,
        ...(known(org.postal_address.zip) ? { postalCode: org.postal_address.zip } : {}),
        addressCountry: 'US',
      },
    })} />
  </head>

  <body data-last-reviewed={lastReviewed}>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <TransparencyBar locale={locale} pageKey={pageKey} />
    <Header locale={locale} pageKey={pageKey} />
    <main id="main" class="layout">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
